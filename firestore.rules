rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isAuth();
      allow create, update: if isAuth() && isOwner(uid);
      allow delete: if false;
    }
    match /pets/{petId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.publicadorId == request.auth.uid;
      allow update: if isAuth() && (resource.data.publicadorId == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apoyadorActivoId','totalRecaudado','estado']));
      allow delete: if isAuth() && resource.data.publicadorId == request.auth.uid;
    }
    match /adoption_requests/{id} {
      allow read: if isAuth() && (resource.data.adoptanteId == request.auth.uid || resource.data.publicadorId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.adoptanteId == request.auth.uid;
      allow update: if isAuth() && resource.data.publicadorId == request.auth.uid;
      allow delete: if false;
    }
    match /chats/{chatId} {
      allow read, write: if isAuth();
      match /messages/{msgId} {
        allow read, write: if isAuth();
      }
    }
    match /location_requests/{id} {
      allow read: if isAuth() && (resource.data.solicitanteId == request.auth.uid || resource.data.propietarioId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.solicitanteId == request.auth.uid;
      allow update: if isAuth() && resource.data.propietarioId == request.auth.uid;
      allow delete: if false;
    }
    match /donations/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.donorId == request.auth.uid;
      allow update: if isAuth();
      allow delete: if false;
    }
    match /vet_requests/{uid} {
      allow read: if isAuth();
      allow create: if isAuth() && isOwner(uid);
      allow update: if isAuth();
      allow delete: if false;
    }
  }
}
